# ==============================================================================
# Enterprise Real-Time Collaboration & Interview Platform — Environment Configuration
# Phase 18 Production Infrastructure & DevOps Specification
# ==============================================================================
# CLASSIFICATION GUIDELINES:
# 1. PUBLIC (Browser-Safe): Must be prefixed with VITE_*. Inlined into client bundle.
#    Never place service-role keys, database passwords, or storage secrets under VITE_*.
# 2. SERVER-ONLY: Used exclusively by Node.js backend processes & workers.
# 3. SECRETS: High-entropy credentials. In production, provide via AWS Secrets Manager,
#    Vault, or sealed environment variables. Never commit actual secret values.
# ==============================================================================

# ==============================================================================
# 1. CORE APPLICATION RUNTIME (Server-Only)
# ==============================================================================
NODE_ENV=development
APP_ENV=development
APP_URL=http://localhost:5173
PORT=5173
LOG_LEVEL=INFO
ADDITIONAL_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ==============================================================================
# 2. FRONTEND CLIENT CONFIGURATION (Public — Inlined into JS bundle)
# ==============================================================================
VITE_APP_NAME="InterviewPrep Enterprise Meet"
VITE_SUPABASE_URL=https://lzjkxfxaiuemjsiflwlv.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imx6amt4ZnhhaXVlbWpzaWZsd2x2Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODg0MDI2ODgsImV4cCI6MjEwMzk3ODY4OH0.PnHnvW9-V8SMLilGdhf3Em9wGIGCYxL0rCRUFpvhdn8
VITE_SOCKET_URL=http://localhost:5173
VITE_LIVEKIT_WS_URL=ws://localhost:7880

# ==============================================================================
# 3. DATABASE (PostgreSQL / Supabase) (Server-Only & Secrets)
# ==============================================================================
# Complete connection string for pooler or direct connection
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/interviewprep
SUPABASE_URL=https://lzjkxfxaiuemjsiflwlv.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imx6amt4ZnhhaXVlbWpzaWZsd2x2Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODg0MDI2ODgsImV4cCI6MjEwMzk3ODY4OH0.PnHnvW9-V8SMLilGdhf3Em9wGIGCYxL0rCRUFpvhdn8
# SERVER-ONLY MASTER KEY: Never expose to browser
SUPABASE_SERVICE_ROLE_KEY=placeholder_supabase_service_role_secret_key

# ==============================================================================
# 4. AUTHENTICATION & TOKENS (Secrets)
# ==============================================================================
# Minimum 32 characters HMAC-SHA256 secret
JWT_SIGNING_SECRET=phase1_auth_super_secret_signing_key_at_least_32_characters_long
MEDIA_JWT_SECRET=phase4_webrtc_sfu_super_secret_signing_key_32_chars_long

# ==============================================================================
# 5. CACHE & COORDINATION (Redis 7+) (Server-Only)
# ==============================================================================
REDIS_URL=redis://:redispassword123@127.0.0.1:6379/0
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=redispassword123

# ==============================================================================
# 6. ASYNCHRONOUS EVENT BUS (Apache Kafka) (Server-Only)
# ==============================================================================
KAFKA_BROKERS=127.0.0.1:9092
KAFKA_CLIENT_ID=frontend-interview-service
KAFKA_GROUP_ID=interviewprep-consumers
KAFKA_USE_SSL=false
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# ==============================================================================
# 7. MEDIA SFU (LiveKit) (Server-Only)
# ==============================================================================
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret_livekit_api_key_must_be_secured
LIVEKIT_WS_URL=ws://127.0.0.1:7880

# ==============================================================================
# 8. OBJECT STORAGE (MinIO / S3) & RECORDINGS (Server-Only & Secrets)
# ==============================================================================
OBJECT_STORAGE_PROVIDER=minio
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET_NAME=interviewprep-recordings-private
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
STORAGE_SIGNING_SECRET=phase17_storage_presigned_url_secret_key_32b_length

# ==============================================================================
# 9. SPEECH-TO-TEXT & TRANSCRIPTION (Server-Only)
# ==============================================================================
TRANSCRIPTION_PROVIDER=local-whisper
WHISPER_BASE_URL=http://127.0.0.1:9000
WHISPER_LANGUAGE=en

# ==============================================================================
# 10. OBSERVABILITY & TELEMETRY (Server-Only)
# ==============================================================================
METRICS_PORT=9090
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318

# ==============================================================================
# 11. FEATURE FLAGS (Server-Only)
# ==============================================================================
ENABLE_RECORDING=true
ENABLE_TRANSCRIPTION=true
ENABLE_ADVANCED_COLLABORATION=true
ENABLE_KAFKA_OUTBOX=true
ENABLE_REDIS_RATE_LIMITER=true
ENABLE_DEEP_HEALTH_CHECKS=true
ENABLE_AUDIT_LOGGING=true
