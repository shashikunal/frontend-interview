# ==============================================================================
# FAANG Frontend Interview Platform — Environment Configuration
# ==============================================================================
# HOW TO USE:
#   1. Copy this file to `.env` for local development.
#   2. Sections marked ACTIVE are read by the code today.
#   3. Sections marked PLANNED are not consumed by any code yet — do not set
#      them expecting behavior changes. They document the cloud target.
#   4. NEVER commit real secrets. Values below are placeholders or local defaults.
#   5. VITE_* variables are INLINED into the browser bundle — never put
#      service-role keys, MinIO secrets, or cloud AI keys behind VITE_*.
# ==============================================================================

# =====================================
# Application (ACTIVE)
# =====================================
# Vite mode / app URL. LOCAL DEFAULTS are fine for development.
APP_ENV=development
APP_URL=http://localhost:5173

# =====================================
# Supabase (ACTIVE) — USER MUST PROVIDE
# =====================================
# Project URL + PUBLIC anon key (client-safe by design; RLS enforces access).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase service-role key — SERVER ONLY, PLANNED (no code uses it today).
# NEVER expose via VITE_*, browser bundle, localStorage, or URLs.
SUPABASE_SERVICE_ROLE_KEY=

# =====================================
# Admin Access (ACTIVE) — USER MUST PROVIDE
# =====================================
# Compared client-side AND used as the admin Supabase password.
# If unset, the build falls back to compiled-in defaults — set these and rotate.
VITE_ADMIN_USERNAME=
VITE_ADMIN_PASSWORD=

# =====================================
# AI Provider — Local Ollama (ACTIVE)
# =====================================
# No API key required. Defaults work when `ollama serve` runs locally.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest
OLLAMA_TIMEOUT_MS=120000
OLLAMA_TEMPERATURE=0.3

# =====================================
# Transcription (ACTIVE)
# =====================================
# Primary engine. Browser never assumes Web Speech as primary.
TRANSCRIPTION_PROVIDER=local-whisper
VITE_TRANSCRIPTION_PROVIDER=local-whisper
# Faster-whisper REST endpoint (must expose GET+POST /asr). No key required.
WHISPER_BASE_URL=http://localhost:9000
VITE_WHISPER_BASE_URL=http://localhost:9000
# Model actually loaded in the sidecar. Never assumed; empty = honestly unconfigured.
WHISPER_MODEL=
VITE_WHISPER_MODEL=
WHISPER_LANGUAGE=en
VITE_WHISPER_LANGUAGE=en
# Start the sidecar (example):
#   pip install faster-whisper uvicorn python-multipart && \
#   uvicorn faster_whisper_server:app --host 127.0.0.1 --port 9000

# =====================================
# Video (ACTIVE, dev-server disk + IndexedDB)
# =====================================
# Permanent recordings target 480p/24fps H.264+AAC (no transcoding step exists yet).
VIDEO_MAX_WIDTH=1280
VIDEO_MAX_HEIGHT=720
VIDEO_DEFAULT_WIDTH=854
VIDEO_DEFAULT_HEIGHT=480
VIDEO_FPS=24
VIDEO_MAX_FPS=30
VIDEO_RETENTION_DAYS=90
# Disk layout used by the dev-server endpoints: storage/interviews/{user_id}/{interview_id}/answers/{answer_id}/
VIDEO_STORAGE_PATH=./storage

# =====================================
# Email / OTP (ACTIVE, serverless only)
# =====================================
# api/send-email.js runs server-side. EmailJS public identifiers are public-safe.
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
# OpenAI — server-side ONLY (api/ai-feedback.js). Never VITE_*.
OPENAI_API_KEY=

# =====================================
# Object Storage — MinIO (PLANNED, not consumed by code yet)
# =====================================
# PRIMARY future video/object storage. Server-side only.
# Ports avoid Whisper (:9000): MinIO API :9001, console :9002.
STORAGE_PROVIDER=minio
MINIO_ENDPOINT=http://localhost:9001
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=mock-interviews
MINIO_REGION=us-east-1
MINIO_USE_SSL=false

# =====================================
# Production Cloud AI (PLANNED, not consumed by code yet)
# =====================================
# Server-side only. Production must never depend on localhost:11434.
CLOUD_AI_PROVIDER=
CLOUD_AI_API_KEY=
CLOUD_AI_MODEL=
