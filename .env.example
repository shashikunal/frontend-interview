# ==============================================================================
# FAANG Frontend Interview Platform - Supabase & Vercel Configuration
# ==============================================================================

# Supabase Project URL (e.g., https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase Public Anon Key (Safe to expose in client frontend)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# EmailJS Configuration (Free Real Email Sending from Browser/Vercel)
# Sign up free at https://www.emailjs.com/ and create an Email Template
VITE_EMAILJS_SERVICE_ID=service_faang_prep
VITE_EMAILJS_TEMPLATE_ID=template_otp_code
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key

# Note: If these keys are left blank or omitted, the application will automatically
# run in "Instant Mail Gateway" demo mode with instant test passcodes (e.g. 123456).

